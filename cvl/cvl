namespace cvl {

struct camera {

    camera() {
        cc = std::make_shared<cvl::cam_config>();
        cc->_flags = 0;
        cc->_stages = 0;
        cc->_mocapAlgo = 3;
        cc->_skipFrames = 2;
        cc->_bbIncrement = 0;
        cc->_bbThickness = 1;
        cc->_faceConfidence = 5;
        cc->_objectConfidence = 5;
        cc->_facerecConfidence = 60;
        cc->_mocapExcludeArea = 2500;
    }

    ~camera() {
        stop();
    }

    using TFrameCallback = std::function<void (const cv::Mat&)>;

    void start(TFrameCallback cbk) {
        _process_thread = std::thread(&camera::process_frames, this);
        if (cbk) { // QT
            _frame_cbk = cbk;
            _queue_thread = std::thread(&camera::queue_frames, this);
        } else { // console
            camera::queue_frames();
        }
    }

    void stop() {
        _stop.store(true,
            std::memory_order_relaxed);
        if (_queue_thread.joinable())
            _queue_thread.join();
        if (_process_thread.joinable())
            _process_thread.join();
        _count = 0;
        _stop.store(false,
            std::memory_order_relaxed);
        q_in.clear();
        q_out.clear();
    }

    auto open_capture() {
        _cap.set(cv::CAP_PROP_HW_ACCELERATION, cv::VIDEO_ACCELERATION_ANY);
        if (!cc->_source.empty()) {
            if (std::ranges::all_of(cc->_source,
                    [](auto c){return std::isdigit(c);})) {
                _cap.open(std::stoi(cc->_source), cv::CAP_ANY);
            } else {
                _cap.open(cc->_source, cv::CAP_ANY);
            }
        }
        if (!_cap.isOpened()) {
            ERR << "queue_frames error: unable to open camera";
            return;
        }
    }

    double m_scalef = 1.0;
    std::shared_ptr<cvl::cam_config> cc;

    private:

    void queue_frames(void) {
        open_capture();
        cv::Mat f_in;
        while (!_stop.load(std::memory_order_relaxed)) {
            _cap >> f_in;
            if (f_in.empty() || f_in.cols <= 0
                || f_in.rows <= 0) continue;
            _count++;
            auto f_square = cvl::geometry::makeSquare(f_in);
            if ((_count % cc->_skipFrames) == 0) {
                q_in.enqueue(f_square);
                auto f_out = q_out.dequeue();
                if (!f_out.empty()) {
                    if (_frame_cbk) {
                        _frame_cbk(f_out);
                    } else {
                        cv::imshow("live", f_out);
                    }
                }
                if (cc->_waitKeyTimeout > 0) {
                    if (cv::waitKey(cc->_waitKeyTimeout) >= 0) {
                        _stop.store(true,
                            std::memory_order_relaxed);
                        break;
                    }
                }
            }
        }
        _cap.release();
        DBG << "queue_frames thread returning";
    }

    void process_frames() {
        cvl::pipeline pipeLine;
        while (!_stop.load(std::memory_order_relaxed)) {
            auto frame = q_in.dequeue();
            if (frame.empty()) {
                std::this_thread::sleep_for(
                    std::chrono::milliseconds(50));
                continue;
            }
            if (cc->_stages) {
                pipeLine.execute(frame, cc);
            }
            q_out.enqueue(frame);
        }
        DBG << "process_frames thread returning";
    }

    uint32_t _count = 0;
    cv::VideoCapture _cap;
    cvl::queue<cv::Mat> q_in;
    cvl::queue<cv::Mat> q_out;
    TFrameCallback _frame_cbk;
    std::thread _queue_thread;
    std::thread _process_thread;
    std::atomic<bool> _stop = {false};
};

inline auto entry(std::vector<std::string> arguments) {
    std::string source = "0";
    if (arguments.size() > 1) {
        source = arguments[1];
    }
    auto cam = std::make_unique<cvl::camera>();
    cam->cc->_source = source;
    cam->cc->_stages = 16;
    cam->start(nullptr);
    getchar();
}
}

using spcamera = std::shared_ptr<cvl::camera>;
using upcamera = std::unique_ptr<cvl::camera>;

